+/*
+ * Acknowledge the detected IC at its own address. Goodix/Focaltech keep
+ * 0x5d/0x38 (their default is correct); the Himax HX83112 on courbet is
+ * at 0x48, so the ack must go to st.ts_addr.
+ */
+static int
+touch_ic_ack(void)
+{
+	if (st.kind == TOUCH_HIMAX) {
+		uint16_t reg16 = GOODIX_EVENT_REG;
+		uint8_t ack[2] = { (uint8_t)(reg16 >> 8), (uint8_t)reg16 };
+		return touch_msg(st.ts_addr, ack, sizeof(ack), NULL, 0, false);
+	}
+	return touch_goodix_ack();
+}
